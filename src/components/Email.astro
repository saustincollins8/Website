---
interface Props {
  address: string;
}

const { address } = Astro.props;

// Encode every character as an HTML entity: browsers decode it, simple address scrapers don't.
const encode = (text: string) =>
  [...text].map((char) => `&#${char.codePointAt(0)};`).join('');

// Given an icon as children, the link shows the icon, is named "Email" for
// screen readers and shows the address as a tooltip.
const icon = Astro.slots.has('default')
  ? await Astro.slots.render('default')
  : '';
const attributes = icon ? ` aria-label="Email" title="${encode(address)}"` : '';
const link = `<a href="${encode(`mailto:${address}`)}"${attributes}>${icon || encode(address)}</a>`;
---

<Fragment set:html={link} />
